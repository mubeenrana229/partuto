{
  "expo": {
    "name": "AutoHub",
    "slug": "autohub-gcc",
    "scheme": "autohub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/hero-promo.jpg",
    "splash": {
      "backgroundColor": "#ff7a00"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autohub.gcc"
    },
    "android": {
      "package": "com.autohub.gcc",
      "adaptiveIcon": {
        "backgroundColor": "#ff7a00"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
